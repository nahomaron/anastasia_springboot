{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Avatar DTO",
  "type": "object",
  "required": ["imageUrl"],
  "properties": {
    "imageUrl": {
      "type": "string",
      "format": "uri"
    },
    "imageSize": {
      "type": ["string", "null"],
      "minLength": 0
    }
  },
  "additionalProperties": true
}
