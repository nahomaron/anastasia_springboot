{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AuthenticationResponse",
  "type": "object",
  "required": ["accessToken"],
  "properties": {
    "accessToken": {
      "type": "string",
      "minLength": 10
    },
    "refreshToken": {
      "type": ["string", "null"],
      "minLength": 1
    },
    "session": {
      "type": "object",
      "properties": {
        "tenantId": { "type": ["string", "null"] },
        "roles": {
          "type": "array",
          "items": { "type": "string" }
        },
        "permissions": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "challengeRequired": {
      "type": "boolean"
    }
  },
  "additionalProperties": true
}
