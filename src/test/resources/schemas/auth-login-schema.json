{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AuthenticationResponse",
  "type": "object",
  "required": ["userId","accessToken", "refreshToken", "user"],
  "properties": {
    "userId": {
      "type": "string",
      "minLength": 10
    },
    "accessToken": {
      "type": "string",
      "minLength": 10
    },
    "refreshToken": {
      "type": "string",
      "minLength": 10
    },
    "user": {
      "type": "object",
      "required": ["id", "email", "fullName"],
      "properties": {
        "id": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "fullName": { "type": "string" },
        "tenantId": { "type": ["string", "null"] },
        "roles": {
          "type": "array",
          "items": { "type": "string" }
        },
        "permissions": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    }
  },
  "additionalProperties": false
}
