{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AuthenticationResponse",
  "type": "object",
  "required": ["access_token", "refresh_token"],
  "properties": {
    "access_token": {
      "type": "string",
      "minLength": 10
    },
    "refresh_token": {
      "type": "string",
      "minLength": 10
    }
  },
  "additionalProperties": false
}
