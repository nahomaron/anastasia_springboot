				</configuration>
			</plugin>

			<!-- 🔹 SpotBugs static analysis -->
			<plugin>
				<groupId>com.github.spotbugs</groupId>
				<artifactId>spotbugs-maven-plugin</artifactId>
				<version>4.9.8.2</version>
				<configuration>
					<effort>Max</effort>
					<threshold>Low</threshold>
					<excludeFilterFile>${project.basedir}/spotbugs-exclude.xml</excludeFilterFile>
				</configuration>
			</plugin>

			<!-- 🔹 JUnit + Allure runtime -->
				<plugin>
					<groupId>org.apache.maven.plugins</groupId>
					<artifactId>maven-surefire-plugin</artifactId>
					<version>${maven.surefire.version}</version>
					<configuration>
						<skipTests>${skip.unit.tests}</skipTests>
						<reuseForks>false</reuseForks>
					<excludedGroups>${experimental.tests.tag}</excludedGroups>
					<includes>
						<include>**/*Test.java</include>
						<include>**/*Tests.java</include>
					</includes>
					<excludes>
						<exclude>**/Api/tests/**/*Test.java</exclude>
						<exclude>**/Api/tests/**/*Tests.java</exclude>
						<exclude>**/*IT.java</exclude>
					</excludes>

					<systemPropertyVariables>
						<allure.results.directory>${project.build.directory}/allure-results</allure.results.directory>
						<spring.flyway.locations>classpath:db/migration-h2,classpath:db/migration</spring.flyway.locations>
						<TESTCONTAINERS_RYUK_DISABLED>false</TESTCONTAINERS_RYUK_DISABLED>
					</systemPropertyVariables>

						<!-- Enable parallel test execution -->
						<parallel>classes</parallel>
						<useUnlimitedThreads>true</useUnlimitedThreads>
						<useModulePath>false</useModulePath>
					</configuration>
				</plugin>

				<plugin>
					<groupId>org.apache.maven.plugins</groupId>
					<artifactId>maven-failsafe-plugin</artifactId>
					<version>${maven.surefire.version}</version>
					<configuration>
						<skipITs>${skip.integration.tests}</skipITs>
						<includes>
							<include>**/*IT.java</include>
					</includes>
					<!-- Integration tests share embedded DB setup and are not parallel-safe. -->
						<parallel>none</parallel>
						<useUnlimitedThreads>false</useUnlimitedThreads>
						<useModulePath>false</useModulePath>
						<systemPropertyVariables>
						<spring.profiles.active>test</spring.profiles.active>
						<allure.results.directory>${project.build.directory}/allure-results/integration</allure.results.directory>
						<spring.flyway.locations>classpath:db/migration-h2,classpath:db/migration</spring.flyway.locations>
					</systemPropertyVariables>
				</configuration>
				<executions>
					<execution>
						<goals>
							<goal>integration-test</goal>
							<goal>verify</goal>
						</goals>
					</execution>
				</executions>
			</plugin>

			<!-- 🔹 Allure report generator -->
			<plugin>
				<groupId>io.qameta.allure</groupId>
				<artifactId>allure-maven</artifactId>
				<version>${allure.version}</version>
				<configuration>
					<reportVersion>2.27.0</reportVersion>
					<resultsDirectory>${project.build.directory}/allure-results</resultsDirectory>
					<reportDirectory>${project.build.directory}/allure-report</reportDirectory>
				</configuration>
			</plugin>

			<!-- 🔹 Spring Boot / Jib (keep yours as is) -->
			<plugin>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-maven-plugin</artifactId>
			</plugin>

			<plugin>
				<groupId>com.google.cloud.tools</groupId>
				<artifactId>jib-maven-plugin</artifactId>
				<version>3.4.1</version>
				<configuration>
					<from>
						<image>eclipse-temurin:21-jre-alpine</image>
					</from>
