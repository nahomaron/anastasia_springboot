		<!-- Black-box API tests -->
		<profile>
			<id>api-tests</id>
			<properties>
				<spring.config.location>classpath:application-api-tests.yml</spring.config.location>
				<skip.unit.tests>false</skip.unit.tests>
				<skip.integration.tests>true</skip.integration.tests>
			</properties>
			<build>
				<plugins>
						<plugin>
							<groupId>org.apache.maven.plugins</groupId>
							<artifactId>maven-surefire-plugin</artifactId>
							<version>${maven.surefire.version}</version>
							<configuration combine.self="override">
								<skipTests>false</skipTests>
								<reuseForks>false</reuseForks>
								<excludedGroups>${experimental.tests.tag}</excludedGroups>
							<includes>
								<include>**/Api/tests/**/*Test.java</include>
								<include>**/Api/tests/**/*Tests.java</include>
							</includes>
							<excludes>
								<exclude>**/*IT.java</exclude>
							</excludes>
							<systemPropertyVariables>
								<spring.profiles.active>api-tests</spring.profiles.active>
								<environment>api-tests</environment>
								<base.url>${env.BASE_URL}</base.url>
								<allure.results.directory>target/allure-results/api</allure.results.directory>
								<spring.flyway.locations>classpath:db/migration-h2,classpath:db/migration</spring.flyway.locations>
								<TESTCONTAINERS_RYUK_DISABLED>false</TESTCONTAINERS_RYUK_DISABLED>
							</systemPropertyVariables>
								<parallel>none</parallel>
								<useUnlimitedThreads>false</useUnlimitedThreads>
								<useModulePath>false</useModulePath>
							</configuration>
						</plugin>
				</plugins>
			</build>
		</profile>
		<profile>
			<id>allure-report</id>
			<build>
				<plugins>
					<!-- Step 1: Copy previous history folder -->
					<plugin>
						<groupId>org.apache.maven.plugins</groupId>
						<artifactId>maven-antrun-plugin</artifactId>
						<version>3.1.0</version>
						<executions>
							<execution>
								<id>copy-allure-history</id>
								<phase>pre-site</phase>
								<configuration>
									<target>
										<echo message="Copying Allure history if exists..." />
										<mkdir dir="${project.build.directory}/allure-results" />
										<copy todir="${project.build.directory}/allure-results" overwrite="true" failonerror="false">
											<fileset dir="${project.build.directory}/allure-report/history" includes="**/*" erroronmissingdir="false"/>
										</copy>
									</target>
								</configuration>
								<goals>
									<goal>run</goal>
								</goals>
							</execution>
						</executions>
					</plugin>

					<!-- Step 2: Generate Allure Report -->
					<plugin>
						<groupId>io.qameta.allure</groupId>
						<artifactId>allure-maven</artifactId>
						<version>${allure.version}</version>
						<configuration>
							<reportVersion>2.17.0</reportVersion>
							<resultsDirectory>${project.build.directory}/allure-results</resultsDirectory>
							<reportDirectory>${project.build.directory}/site/allure-maven-plugin</reportDirectory>
						</configuration>
						<executions>
							<execution>
								<id>generate-allure-report</id>
								<phase>verify</phase>
								<goals>
									<goal>report</goal>
								</goals>
							</execution>
							<execution>
								<id>serve-allure-report</id>
								<phase>post-site</phase>
								<goals>
									<goal>serve</goal>
								</goals>
							</execution>
						</executions>
					</plugin>
				</plugins>
			</build>
		</profile>
	</profiles>

